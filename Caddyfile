:{$PORT:80} {
	root * /srv
	encode zstd gzip
	file_server
	try_files {path} {path}/ /index.html
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Revalidate on every visit (a cheap 304 via ETag) so a deploy shows up
		# immediately instead of after the browser's heuristic cache expires.
		Cache-Control "no-cache"
		-Server
	}
}
